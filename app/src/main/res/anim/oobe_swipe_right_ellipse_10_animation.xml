<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_2"
            android:duration="250"
            android:valueFrom="0.5"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_4"
            android:duration="500"
            android:valueFrom="1"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_3"
            android:duration="500"
            android:valueFrom="1"
            android:valueTo="0.5"
            android:valueType="floatType"
            android:propertyName="scaleX"/>
    </set>
    <set android:ordering="sequentially">
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_2"
            android:duration="250"
            android:valueFrom="0.5"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_4"
            android:duration="500"
            android:valueFrom="1"
            android:valueTo="1"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
        <objectAnimator
            android:interpolator="@interpolator/oobe_swipe_right_animation_interpolator_3"
            android:duration="500"
            android:valueFrom="1"
            android:valueTo="0.5"
            android:valueType="floatType"
            android:propertyName="scaleY"/>
    </set>
</set>
