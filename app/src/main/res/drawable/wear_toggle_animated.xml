<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:id="@+id/wear_toggle_on"
        android:drawable="@drawable/ic_wear_toggle_on"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:id="@+id/wear_toggle_off"
        android:drawable="@drawable/ic_wear_toggle_off"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:id="@+id/wear_toggle_on_disabled"
        android:drawable="@drawable/ic_wear_toggle_on"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:id="@+id/wear_toggle_off_disabled"
        android:drawable="@drawable/ic_wear_toggle_off"/>
    <transition
        android:drawable="@drawable/wear_toggle_off_to_on_animation"
        android:toId="@+id/wear_toggle_on"
        android:fromId="@+id/wear_toggle_off"/>
    <transition
        android:drawable="@drawable/wear_toggle_on_to_off_animation"
        android:toId="@+id/wear_toggle_off"
        android:fromId="@+id/wear_toggle_on"/>
    <transition
        android:drawable="@drawable/wear_toggle_disabled_off_to_on_animation"
        android:toId="@+id/wear_toggle_on_disabled"
        android:fromId="@+id/wear_toggle_off_disabled"/>
    <transition
        android:drawable="@drawable/wear_toggle_disabled_on_to_off_animation"
        android:toId="@+id/wear_toggle_off_disabled"
        android:fromId="@+id/wear_toggle_on_disabled"/>
</animated-selector>
