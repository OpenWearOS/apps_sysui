<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <io.github.openwearos.sysui.ui.WearCircularButton
        android:id="@+id/wear_alertdialog_negative_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@android:string/cancel"
        style="?attr/wearAlertDialogButtonNegativeStyle"/>
    <io.github.openwearos.sysui.ui.WearCircularButton
        android:id="@+id/wear_alertdialog_positive_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@android:string/ok"
        style="?attr/wearAlertDialogButtonPositiveStyle"/>
</LinearLayout>
