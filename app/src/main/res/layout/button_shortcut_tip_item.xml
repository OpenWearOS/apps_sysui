<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/button_shortcut_tip_item_scrollview"
    android:background="@color/tutorial_overlay_background"
    android:paddingBottom="@dimen/button_shortcut_tip_padding_bottom"
    android:fadingEdgeLength="@dimen/button_shortcut_fading_edge_length"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/overlay_top_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_shortcut_tip_guideline_top"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/overlay_start_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_shortcut_tip_guideline_start"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/overlay_end_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_shortcut_tip_guideline_end"/>
        <ImageView
            android:id="@+id/button_shortcut_tip_image"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_shortcut_tip_image_height"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="@+id/overlay_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/overlay_start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/overlay_top_guideline"/>
        <TextView
            android:textColor="?attr/colorPrimaryVariant"
            android:id="@+id/button_shortcut_tip_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_shortcut_tip_image_margin_top"
            android:textAlignment="center"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/overlay_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/overlay_start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/button_shortcut_tip_image"
            style="?attr/textStyleWearTitle3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
