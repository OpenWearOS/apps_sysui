<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/button_press_hint_scrollview"
    android:background="@color/tutorial_overlay_background"
    android:fadingEdgeLength="@dimen/button_press_fading_edge_length"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_press_hint_overlay_container"
        android:paddingBottom="@dimen/button_press_hint_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/overlay_start_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_press_hint_guideline_start"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/overlay_end_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_press_hint_guideline_end"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/overlay_top_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/button_press_hint_guideline_top"/>
        <ImageView
            android:id="@+id/button_press_animation"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_press_animation_height"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="@id/overlay_end_guideline"
            app:layout_constraintStart_toStartOf="@id/overlay_start_guideline"
            app:layout_constraintTop_toTopOf="@id/overlay_top_guideline" />
        <io.github.openwearos.sysui.ui.ButtonPressView
            android:id="@+id/button_press_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_press_animation_height"
            app:layout_constraintEnd_toEndOf="@+id/overlay_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/overlay_start_guideline"
            app:layout_constraintTop_toTopOf="@+id/overlay_top_guideline"/>
        <TextView
            android:textColor="?attr/colorPrimaryVariant"
            android:id="@+id/button_press_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/button_press_text_margin_top"
            android:maxLines="@integer/button_press_text_max_lines"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/overlay_end_guideline"
            app:layout_constraintStart_toStartOf="@+id/overlay_start_guideline"
            app:layout_constraintTop_toBottomOf="@+id/button_press_view"
            style="?attr/textStyleWearTitle3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
