<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/managementui_root_container"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.wear.widget.CurvedTextView
        android:textAppearance="@style/TextAppearance.WearMaterial.Body3"
        android:textSize="@dimen/managementui_title_non_scalable_font_size"
        android:ellipsize="end"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/managementui_item_name_curve"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/managementui_item_name_curve_padding"
        android:layout_marginRight="@dimen/managementui_item_name_curve_padding"
        android:layout_marginBottom="@dimen/managementui_item_name_curve_padding"
        app:maxSweepDegrees="@dimen/managementui_max_sweep_degrees"/>
    <io.github.openwearos.sysui.ui.WearTimeText
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/managementui_item_name_wear_time"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/managementui_item_name_curve_padding"
        android:layout_marginRight="@dimen/managementui_item_name_curve_padding"
        android:layout_marginBottom="@dimen/managementui_item_name_curve_padding"
        style="@style/WearText.Button"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:addStatesFromChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/managementui_items_padding"
        android:paddingEnd="@dimen/managementui_items_padding"
        android:stateListAnimator="@animator/managementui_raise">
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/managementui_item_name"
            android:layout_width="@dimen/managementui_item_name_width"
            android:layout_height="@dimen/managementui_item_name_height"
            android:maxLines="1"
            android:shadowColor="@color/managementui_item_title_shadow_color"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            style="@style/WearText.Title"/>
        <FrameLayout
            android:id="@+id/managementui_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/managementui_preview_image_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/managementui_preview_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/managementui_item_elevation"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
