<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charging_container"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="2dp">
    <ImageView
        android:id="@+id/centered_power_icon"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_power_green"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/top_offset_percentage"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/bottom_offset_percentage"/>
    <TextView
        android:textAppearance="?attr/textAppearanceWearBody2"
        android:textSize="@dimen/wear_material_text_size_body4_dp"
        android:textColor="?attr/chargingOverlayContentColor"
        android:ellipsize="end"
        android:id="@+id/battery_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:alpha="0"
        android:drawableStart="@drawable/ic_power_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_guideline"/>
    <io.github.openwearos.sysui.ui.GradientTextClock
        android:textAppearance="?attr/textAppearanceWearDisplay1"
        android:textSize="@dimen/main_time_size"
        android:textStyle="normal"
        android:textColor="?attr/chargingOverlayContentColor"
        android:gravity="center"
        android:id="@+id/text_clock"
        android:layout_width="@dimen/gradient_clock_width"
        android:layout_height="@dimen/gradient_clock_height"
        android:lines="2"
        android:includeFontPadding="false"
        android:lineSpacingExtra="16dp"
        android:lineSpacingMultiplier="0.5"
        android:alpha="0"
        android:fontFeatureSettings="tnum"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="?attr/textAppearanceWearBody2"
        android:textSize="@dimen/wear_material_text_size_body4_dp"
        android:ellipsize="end"
        android:id="@+id/date_or_upcoming_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/unread_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_unread_dot"
        android:contentDescription="@string/unread_notification_dot_content_description"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date_or_upcoming_alarm"/>
</androidx.constraintlayout.widget.ConstraintLayout>
