<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/carousel_label_icon_root"
    android:layout_width="@dimen/carousel_label_container_width"
    android:layout_height="@dimen/carousel_label_container_height">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/carousel_label_icon_container"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="6dp">
        <FrameLayout
            android:id="@+id/carousel_label_current_frame"
            android:layout_width="@dimen/carousel_label_icon_size"
            android:layout_height="@dimen/carousel_label_icon_size"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/carousel_label_current_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/carousel_label_next_frame"
            android:layout_width="@dimen/carousel_label_icon_size"
            android:layout_height="@dimen/carousel_label_icon_size"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/carousel_label_next_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
