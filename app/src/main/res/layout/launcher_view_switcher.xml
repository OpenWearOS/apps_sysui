<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/launcher_view_switcher_button_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <FrameLayout
        android:id="@+id/launcher_view_switcher_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/launcher_view_switcher_title_text_size"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pref_launcher_ui_mode_title"
            style="?attr/textStyleWearButton1"/>
    </FrameLayout>
    <io.github.openwearos.sysui.ui.launcheruimode.LauncherViewSwitcherButton
        android:id="@+id/launcher_view_switcher_grid_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_view_switcher_button_top_margin"
        android:checked="false"
        android:checkable="true"
        android:contentDescription="@string/grid_launcher_ui_mode_pref_entry_name"
        android:layout_marginEnd="@dimen/launcher_view_switcher_button_horizontal_margin"
        app:buttonBackgroundColor="@color/launcher_view_switcher_circular_button_background"
        app:icon="@drawable/icon_grid"
        app:layout_constraintEnd_toStartOf="@+id/launcher_view_switcher_button_guide"
        app:layout_constraintTop_toBottomOf="@+id/launcher_view_switcher_title"
        app:size="large"
        app:toggleOnClick="false"/>
    <io.github.openwearos.sysui.ui.launcheruimode.LauncherViewSwitcherButton
        android:id="@+id/launcher_view_switcher_list_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_view_switcher_button_top_margin"
        android:checked="false"
        android:checkable="true"
        android:contentDescription="@string/list_launcher_ui_mode_pref_entry_name"
        android:layout_marginStart="@dimen/launcher_view_switcher_button_horizontal_margin"
        app:buttonBackgroundColor="@color/launcher_view_switcher_circular_button_background"
        app:icon="@drawable/icon_list"
        app:layout_constraintStart_toEndOf="@+id/launcher_view_switcher_button_guide"
        app:layout_constraintTop_toBottomOf="@+id/launcher_view_switcher_title"
        app:size="large"
        app:toggleOnClick="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
