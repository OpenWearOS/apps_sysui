<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/button_tip_watch_frame"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/button_tip_screen_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/button_tip_press_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/button_tip_static_button_layers"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>