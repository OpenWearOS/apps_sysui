<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/managementui_main_container"
        android:background="?attr/colorBackground"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/managementui_list"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/managementui_delete_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/managementui_settings_area"
            android:paddingTop="@dimen/managementui_top_button_margin"
            android:paddingBottom="@dimen/managementui_bottom_button_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">
            <io.github.openwearos.sysui.ui.WearCircularButton
                android:id="@+id/managementui_rearrange_left"
                android:layout_width="@dimen/managementui_rearrange_button_size"
                android:layout_height="@dimen/managementui_rearrange_button_size"
                android:layout_marginBottom="@dimen/managementui_rearrange_circular_settings"
                android:layout_marginEnd="@dimen/managementui_rearrange_padding_settings"
                app:icon="@drawable/quantum_gm_ic_arrow_left_vd_theme_24"
                app:size="small"
                style="@style/ManagementUiRearrangeButton"/>
            <io.github.openwearos.sysui.ui.WearChipButton
                android:id="@+id/managementui_item_settings"
                android:layout_width="@dimen/managementui_rearrange_chip_width"
                android:layout_height="@dimen/managementui_rearrange_button_size"
                android:layout_marginTop="@dimen/managementui_rearrange_circular_settings"
                app:size="small"
                style="@style/ManagementUiSettingsButton"/>
            <io.github.openwearos.sysui.ui.WearCircularButton
                android:id="@+id/managementui_rearrange_right"
                android:layout_width="@dimen/managementui_rearrange_button_size"
                android:layout_height="@dimen/managementui_rearrange_button_size"
                android:layout_marginBottom="@dimen/managementui_rearrange_circular_settings"
                android:layout_marginStart="@dimen/managementui_rearrange_padding_settings"
                app:icon="@drawable/quantum_gm_ic_arrow_right_vd_theme_24"
                app:size="small"
                style="@style/ManagementUiRearrangeButton"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.wear.widget.SwipeDismissFrameLayout
        android:id="@+id/managementui_swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/managementui_all_items"/>
    </androidx.wear.widget.SwipeDismissFrameLayout>
</merge>
