<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:clipChildren="false">
    <io.github.openwearos.sysui.ui.time.WearTimeText
        android:gravity="center"
        android:id="@+id/scrolling_time_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:id="@+id/main"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/vertical_begin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/agenda_list_v2_percent_begin"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/vertical_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@dimen/agenda_list_v2_percent_end"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/days_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/vertical_end"
                app:layout_constraintStart_toStartOf="@+id/vertical_begin"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/app_icon"
        android:background="@drawable/agenda_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
    <io.github.openwearos.sysui.ui.common.views.ambient.AmbientableTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/relative_day_header_no_event"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_view_v2_day_header_margin_top"
        style="@style/AgendaText.EventText.Header"/>
    <io.github.openwearos.sysui.ui.common.views.ambient.AmbientableTextView
        android:textColor="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/no_event"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cal_no_event_v2"
        style="@style/Widget.TextView.WearMaterial.Body2"/>
</merge>
